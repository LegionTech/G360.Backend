{
  "version": "0.2.0",
  "configurations": [
    
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/LegionTech.G360.API/bin/Debug/net8.0/LegionTech.G360.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
              "ASPNETCORE_URLS": "http://localhost:5049",
              "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on:\\s+http://localhost:(5049)",
                "uriFormat": "http://localhost:%s/swagger"
            },
            "launchSettingsProfile": "http"
        }
  ]
}